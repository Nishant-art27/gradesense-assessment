# GradeSense configuration.
#
# Everything here is optional. With no .env at all the app runs on the
# deterministic rule-based grader — no key, no network, no cost — which is how
# the sample papers and the whole test suite run.
#
# Copy to .env and fill in a key only when you want a real model to mark.
#   cp .env.example .env

# mock | groq | gemini | anthropic        (default: mock)
MODEL_PROVIDER=mock

# Needed when MODEL_PROVIDER=groq. Get one at https://console.groq.com/keys
# Groq's free tier is by far the most generous of the three: 1,000 requests a
# day against Gemini's 20. A paper costs one request per question.
GROQ_API_KEY=

# Needed when MODEL_PROVIDER=gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Needed when MODEL_PROVIDER=anthropic. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Override the model. Defaults per provider:
#   groq       -> openai/gpt-oss-120b
#   gemini     -> gemini-2.5-flash
#   anthropic  -> claude-opus-5
#
# On Groq, only a few models support strict JSON-schema output, which the
# grader requires: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b.
# GRADING_MODEL=openai/gpt-oss-20b

# API port (default 4000). The web app proxies /api here.
# PORT=4000

# Below this confidence a result is flagged for human review (default 0.65).
# CONFIDENCE_REVIEW_THRESHOLD=0.65
