# GradeSense configuration
#
# Copy to `.env` and fill in if you want to use the real Claude API.
# The app runs fully — including the entire test suite — without any of this,
# because MODEL_PROVIDER defaults to "mock".

# "mock" (default) | "anthropic"
MODEL_PROVIDER=mock

# Only needed when MODEL_PROVIDER=anthropic. Never commit the real value.
ANTHROPIC_API_KEY=

# Model used for grading. Must be vision-capable — the diagram criteria
# depend on Claude seeing the rendered answer page.
GRADING_MODEL=claude-opus-5

# Server port
PORT=4000

# Below this confidence, the result is flagged for human review.
CONFIDENCE_REVIEW_THRESHOLD=0.65
